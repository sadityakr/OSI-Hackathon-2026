# secrets
.env

# machine-specific environment and generated caches
.venv/
__pycache__/
*.egg-info/
.ipynb_checkpoints/
.DS_Store
__marimo__/
skill/dist/

# downloaded data (data/get_data.ps1; sources and licences in data/README.md). Only the CRD cache of layered
# crystals, data/raw/crd/crd_2d.pkl (CC BY 4.0), is tracked so the matcher works without the 454 MB download.
data/raw/*
!data/raw/crd/
data/raw/crd/*
!data/raw/crd/crd_2d.pkl

# evaluation run output with full agent transcripts (results without transcripts are in results/)
eval/runs/
