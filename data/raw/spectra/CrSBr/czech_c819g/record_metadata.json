z/api/records/72gk1-7mb53/access", "communities": "https://datarepo.eosc.cz/api/records/72gk1-7mb53/communities", "communities-suggestions": "https://datarepo.eosc.cz/api/records/72gk1-7mb53/communities-suggestions", "request_deletion": "https://datarepo.eosc.cz/api/records/72gk1-7mb53/request-deletion", "file_modification": "https://datarepo.eosc.cz/api/records/72gk1-7mb53/file-modification", "quota_increase": "https://datarepo.eosc.cz/api/records/72gk1-7mb53/quota-increase", "requests": "https://datarepo.eosc.cz/api/requests/?topic=record:72gk1-7mb53", "applicable-requests": "https://datarepo.eosc.cz/api/requests/applicable?topic=record:72gk1-7mb53"}, "revision_id": 4, "parent": {"id": "c819g-kjx76", "access": {"owned_by": {"user": "92"}, "settings": {"allow_user_requests": false, "allow_guest_requests": false, "accept_conditions_text": null, "secret_link_expiration": 0}}, "communities": {"ids": ["f1b37af7-2ffd-40e3-9751-6fd8223ef84f"], "default": "f1b37af7-2ffd-40e3-9751-6fd8223ef84f", "entries": [{"id": "f1b37af7-2ffd-40e3-9751-6fd8223ef84f", "created": "2026-06-18T14:48:26.086745+00:00", "updated": "2026-07-27T14:19:58.121709+00:00", "links": {}, "revision_id": 3, "slug": "heyrovsky", "metadata": {"title": "J. Heyrovsky Institute Community"}, "access": {"visibility": "public", "members_visibility": "public", "member_policy": "closed", "record_submission_policy": "open", "review_policy": "closed"}, "custom_fields": {"workflow": "community", "allowed_workflows": ["community"]}, "deletion_status": {"is_deleted": false, "status": "P"}, "children": {"allow": false}}]}, "pids": {"doi": {"identifier": "10.48700/c819g-kjx76", "provider": "datacite", "client": "datacite"}}, "workflow": "community"}, "versions": {"is_latest": true, "index": 1}, "is_published": true, "is_draft": false, "pids": {"doi": {"identifier": "10.48700/72gk1-7mb53", "provider": "datacite", "client": "datacite"}, "oai": {"identifier": "oai:datarepo.eosc.cz:72gk1-7mb53", "provider": "oai"}}, "metadata": {"publication_date": "2026-10-07", "version": "R1", "title": "Dataset for Interplay of Cl Substitution and He+ Irradiation in CrSBr_{1-x}Cl_{x}", "description": "<p>This dataset supports the article \"Interplay of Cl Substitution and He+ Irradiation in CrSBr_{1-x}Cl_{x}\" that is being considered for publication in Physica Status Solidi B. In this work, we show how Cl substitution and He+ irradiation affect the Raman of CrSBr using polarization-resolved Raman spectroscopy under resonant and off-resonant conditions.</p>", "publisher": "Data Catch-all Repository", "additional_descriptions": [{"description": "<p>Two-dimensional magnetic semiconductors provide a promising platform for exploring the interplay between disorder, lattice dynamics, and resonant light--matter interactions. Among them, CrSBr exhibits strong in-plane anisotropy and pronounced resonance-enhanced Raman scattering. Here, using polarization-resolved Raman spectroscopy, we treat Cl substitution as a pre-existing disorder landscape and He$^{+}$ irradiation as a subsequent controlled perturbation to examine how the irradiation response depends on the initial disorder state of CrSBr_{1-x}Cl_{x}. Cl substitution activates additional phonon modes associated with local symmetry breaking, while He$^{+}$ irradiation introduces distinct defect-related scattering channels and enhanced phonon broadening. The combined effects of alloy disorder and externally introduced defects lead to strong anisotropic reconstruction of the Raman spectra and modification of the nonlinear Raman response under near-resonant 1.96 eV excitation. Power-dependent measurements reveal superlinear scaling of both intrinsic and substitution-induced phonon modes, indicating persistent resonance-enhanced electron--phonon coupling even in defect-engineered samples.</p>", "type": {"id": "abstract", "title": {"cs": "Abstrakt", "en": "Abstract"}}, "lang": {"id": "eng", "title": {"cs": "angli\u010dtina", "en": "English"}}}, {"description": "<p>The methodology includes sample preparation using tape-assisted exfoliation as well as dry transfer of pristine CrSBr and Cl-substituted CrSBr followed by He+ irradiation and characterization using polarization-resolved Raman spectroscopy and atomic force microscopy (AFM).&nbsp; The data analyses was carried out using Origin 2019 software.</p>", "type": {"id": "methods", "title": {"cs": "Metodologie", "en": "Methods"}}, "lang": {"id": "eng", "title": {"cs": "angli\u010dtina", "en": "English"}}}, {"description": "<p>The data is provided in Excel spreadsheets All the datasets are accompanied by the respective figures and located in folders named after the figures (eg, Figure 1, Figure 2, etc.).</p>\n<p>This 3 MB file contains raw data for 5 figures from the main manuscript and for 8 supporting figures.&nbsp;</p>", "type": {"id": "technical-info", "title": {"cs": "Technick\u00e1 informace", "en": "Technical Info"}}, "lang": {"id": "eng", "title": {"cs": "angli\u010dtina", "en": "English"}}}], "creators": [{"person_or_org": {"type": "personal", "name": "Sahu, Satyam", "given_name": "Satyam", "family_name": "Sahu", "identifiers": [{"identifier": "0000-0001-7306-1806", "scheme": "orcid"}]}, "affiliations": [{"id": "02sat5y74", "name": "Czech Academy of Sciences, Heyrovsky Institute", "identifiers": [{"identifier": "02sat5y74", "scheme": "ror"}, {"identifier": "grid.425073.7", "scheme": "grid"}, {"identifier": "0000 0004 0633 9822", "scheme": "isni"}]}]}], "contributors": [{"person_or_org": {"type": "personal", "name": "Wu, Bing", "given_name": "Bing", "family_name": "Wu", "identifiers": [{"identifier": "0000-0002-9637-6787", "scheme": "orcid"}]}, "role": {"id": "other", "title": {"cs": "Jin\u00e1 role", "en": "Other"}}, "affiliations": [{"id": "05ggn0a85", "name": "University of Chemistry and Technology, Prague", "identifiers": [{"identifier": "05ggn0a85", "scheme": "ror"}, {"identifier": "grid.448072.d", "scheme": "grid"}, {"identifier": "0000 0004 0635 6059", "sche